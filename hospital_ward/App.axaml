<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MyFirstApp.App"
             xmlns:local="using:MyFirstApp"
             xmlns:behaviors="using:MyFirstApp.Behaviors"
             RequestedThemeVariant="Light">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>

        <!-- glass 卡片基础样式 -->
        <Style Selector="Border.glass">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BoxShadow" Value="0 4 12 0 #0D000000" />
            <!-- 优化: CubicEaseOut 更符合物理直觉，同时过渡 transform+shadow -->
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform"
                                                   Duration="0:0:0.25" Easing="CubicEaseOut" />
                    <BoxShadowsTransition Property="BoxShadow"
                                          Duration="0:0:0.25" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <!-- 优化: scale 降至1.015，幅度更克制，配合translateY避免抖动 -->
        <Style Selector="Border.glass:pointerover">
            <Setter Property="RenderTransform" Value="translateY(-4px) scale(1.015)" />
            <Setter Property="BoxShadow" Value="0 14 28 0 #13000000" />
        </Style>

        <!-- 侧栏承载滚动条，不参与悬浮位移，避免拖拽坐标与视觉位置错位 -->
        <Style Selector="Border.glass.sidebar-shell:pointerover">
            <Setter Property="RenderTransform" Value="translateY(0px) scale(1)" />
            <Setter Property="BoxShadow" Value="0 4 12 0 #0D000000" />
        </Style>

        <Style Selector="TextBlock.glass-title">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#6B7280" />
        </Style>
        <Style Selector="TextBlock.glass-value">
            <Setter Property="FontSize" Value="32" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!-- 滚动条仅保留安全的顶层尺寸配置，避免干预 Fluent 默认拖拽语义 -->
        <Style Selector="ScrollBar#PART_VerticalScrollBar">
            <Setter Property="AllowAutoHide" Value="True" />
            <Setter Property="ShowDelay" Value="0:0:0.04" />
            <Setter Property="HideDelay" Value="0:0:0.28" />
            <Setter Property="Width" Value="14" />
            <Setter Property="MinWidth" Value="14" />
            <Setter Property="Margin" Value="0,6,4,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <!-- 竖向滚动条柔化：上下端半圆收口，箭头与滑块都更圆润 -->
        <Style Selector="ScrollBar#PART_VerticalScrollBar:vertical /template/ Border#VerticalRoot">
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <Style Selector="ScrollBar#PART_VerticalScrollBar:vertical /template/ Rectangle#TrackRect">
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Stroke" Value="Transparent" />
        </Style>

        <Style Selector="ScrollBar#PART_VerticalScrollBar:vertical /template/ Thumb">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Background" Value="#C8CDD3" />
            <Setter Property="RenderTransform" Value="none" />
        </Style>

        <Style Selector="ScrollBar#PART_VerticalScrollBar:vertical /template/ RepeatButton#PART_LineUpButton">
            <Setter Property="TextElement.Foreground" Value="#D5D9DF" />
        </Style>

        <Style Selector="ScrollBar#PART_VerticalScrollBar:vertical /template/ RepeatButton#PART_LineDownButton">
            <Setter Property="TextElement.Foreground" Value="#D5D9DF" />
        </Style>

        <Style Selector="ScrollBar#PART_VerticalScrollBar:vertical /template/ RepeatButton#PART_LineUpButton /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="7,7,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="ScrollBar#PART_VerticalScrollBar:vertical /template/ RepeatButton#PART_LineDownButton /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="0,0,7,7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="ScrollBar#PART_VerticalScrollBar:vertical /template/ RepeatButton#PART_LineUpButton:pointerover">
            <Setter Property="TextElement.Foreground" Value="#F8FAFC" />
        </Style>

        <Style Selector="ScrollBar#PART_VerticalScrollBar:vertical /template/ RepeatButton#PART_LineDownButton:pointerover">
            <Setter Property="TextElement.Foreground" Value="#F8FAFC" />
        </Style>

        <Style Selector="ScrollBar#PART_VerticalScrollBar:vertical /template/ RepeatButton#PART_LineUpButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="ScrollBar#PART_VerticalScrollBar:vertical /template/ RepeatButton#PART_LineDownButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="ScrollBar#PART_VerticalScrollBar:vertical /template/ RepeatButton#PART_LineUpButton:pressed">
            <Setter Property="TextElement.Foreground" Value="#FFFFFF" />
        </Style>

        <Style Selector="ScrollBar#PART_VerticalScrollBar:vertical /template/ RepeatButton#PART_LineDownButton:pressed">
            <Setter Property="TextElement.Foreground" Value="#FFFFFF" />
        </Style>

        <Style Selector="ScrollBar#PART_VerticalScrollBar:vertical /template/ RepeatButton#PART_LineUpButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="ScrollBar#PART_VerticalScrollBar:vertical /template/ RepeatButton#PART_LineDownButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="ScrollBar#PART_VerticalScrollBar:vertical /template/ RepeatButton#PART_LineUpButton PathIcon">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="6" />
            <Setter Property="Opacity" Value="0.82" />
        </Style>

        <Style Selector="ScrollBar#PART_VerticalScrollBar:vertical /template/ RepeatButton#PART_LineDownButton PathIcon">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="6" />
            <Setter Property="Opacity" Value="0.82" />
        </Style>

        <Style Selector="ScrollBar#PART_HorizontalScrollBar">
            <Setter Property="AllowAutoHide" Value="True" />
            <Setter Property="ShowDelay" Value="0:0:0.04" />
            <Setter Property="HideDelay" Value="0:0:0.28" />
            <Setter Property="Height" Value="14" />
            <Setter Property="MinHeight" Value="14" />
            <Setter Property="Margin" Value="6,0,6,4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <!-- 左侧导航仅保留滚动行为语义，视觉统一走全局规则 -->
        <Style Selector="ListBox.sidebar-nav">
            <Setter Property="ScrollViewer.AllowAutoHide" Value="False" />
            <Setter Property="ScrollViewer.IsScrollInertiaEnabled" Value="True" />
            <Setter Property="ScrollViewer.IsScrollChainingEnabled" Value="False" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible" />
        </Style>

        <Style Selector="ListBox.sidebar-nav /template/ ScrollViewer#PART_ScrollViewer">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="behaviors:SmoothScroll.IsEnabled" Value="True" />
            <Setter Property="behaviors:SmoothScroll.WheelPixels" Value="64" />
            <Setter Property="behaviors:SmoothScroll.Duration" Value="0:0:0.24" />
        </Style>
    </Application.Styles>
</Application>
