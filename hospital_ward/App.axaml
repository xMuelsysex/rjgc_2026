<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MyFirstApp.App"
             xmlns:local="using:MyFirstApp"
             RequestedThemeVariant="Light">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>

        <!-- glass 卡片基础样式 -->
        <Style Selector="Border.glass">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BoxShadow" Value="0 4 12 0 #0D000000" />
            <!-- 优化: CubicEaseOut 更符合物理直觉，同时过渡 transform+shadow -->
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform"
                                                   Duration="0:0:0.25" Easing="CubicEaseOut" />
                    <BoxShadowsTransition Property="BoxShadow"
                                          Duration="0:0:0.25" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <!-- 优化: scale 降至1.015，幅度更克制，配合translateY避免抖动 -->
        <Style Selector="Border.glass:pointerover">
            <Setter Property="RenderTransform" Value="translateY(-4px) scale(1.015)" />
            <Setter Property="BoxShadow" Value="0 14 28 0 #13000000" />
        </Style>

        <Style Selector="TextBlock.glass-title">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#6B7280" />
        </Style>
        <Style Selector="TextBlock.glass-value">
            <Setter Property="FontSize" Value="32" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </Application.Styles>
</Application>
