<UserControl
    x:Class="MyFirstApp.Views.BedManagementView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:MyFirstApp.ViewModels"
    d:DesignHeight="600"
    d:DesignWidth="900"
    x:DataType="vm:BedManagementViewModel"
    mc:Ignorable="d">

    <Border Background="#F9FAFB" CornerRadius="16" Margin="16" Padding="24">
        <Grid RowDefinitions="Auto, Auto, *, Auto">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="28"
                FontWeight="Bold"
                Foreground="#111827"
                Text="病房床位管理" />

            <!--  搜索栏 + 操作按钮  -->
            <StackPanel
                Grid.Row="1"
                Margin="0,0,0,16"
                Orientation="Horizontal"
                Spacing="10">
                <TextBox
                    Width="240"
                    Text="{Binding SearchText}"
                    Watermark="搜索床位号/病房号..."
                    CornerRadius="8" />
                <Button
                    Padding="16,8"
                    Background="#10B981"
                    CornerRadius="8"
                    Command="{Binding AddCommand}"
                    Content="添加床位"
                    FontWeight="SemiBold"
                    Foreground="White" />
                <Button
                    Padding="16,8"
                    Background="#3B82F6"
                    CornerRadius="8"
                    Command="{Binding EditCommand}"
                    Content="编辑"
                    FontWeight="SemiBold"
                    Foreground="White" />
                <Button
                    Padding="16,8"
                    Background="#EF4444"
                    CornerRadius="8"
                    Command="{Binding DeleteCommand}"
                    Content="删除"
                    FontWeight="SemiBold"
                    Foreground="White" />
            </StackPanel>

            <!--  数据表格  -->
            <DataGrid
                Grid.Row="2"
                AutoGenerateColumns="False"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CanUserResizeColumns="True"
                CornerRadius="8"
                GridLinesVisibility="Horizontal"
                IsReadOnly="True"
                ItemsSource="{Binding FilteredBeds}"
                SelectedItem="{Binding SelectedBed}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding BedNumber}"
                        Header="床位号" />
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding WardNumber}"
                        Header="所属病房" />
                    <DataGridTextColumn
                        Width="80"
                        Binding="{Binding Status}"
                        Header="状态" />
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding PatientName}"
                        Header="当前患者" />
                </DataGrid.Columns>
            </DataGrid>

            <!--  编辑面板  -->
            <Border
                Grid.Row="3"
                Classes="glass"
                Margin="0,16,0,0"
                Padding="20"
                IsVisible="{Binding IsEditing}">
                <StackPanel Spacing="16">
                    <TextBlock
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="#111827"
                        Text="编辑床位信息" />
                    
                    <StackPanel Orientation="Horizontal" Spacing="20">
                        <StackPanel Spacing="6">
                            <TextBlock
                                FontSize="13"
                                Foreground="#6B7280"
                                FontWeight="Medium"
                                Text="床位号" />
                            <TextBox Width="160" CornerRadius="6" Text="{Binding EditBedNumber}" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock
                                FontSize="13"
                                Foreground="#6B7280"
                                FontWeight="Medium"
                                Text="所属病房" />
                            <TextBox Width="160" CornerRadius="6" Text="{Binding EditWardNumber}" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock
                                FontSize="13"
                                Foreground="#6B7280"
                                FontWeight="Medium"
                                Text="状态" />
                            <ComboBox Width="120" CornerRadius="6" SelectedItem="{Binding EditStatus}">
                                <ComboBoxItem Content="空闲" />
                                <ComboBoxItem Content="占用" />
                                <ComboBoxItem Content="维修" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock
                                FontSize="13"
                                Foreground="#6B7280"
                                FontWeight="Medium"
                                Text="患者姓名" />
                            <TextBox Width="160" CornerRadius="6" Text="{Binding EditPatientName}" />
                        </StackPanel>
                    </StackPanel>
                    
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Spacing="12">
                        <Button
                            Padding="24,8"
                            Background="#10B981"
                            CornerRadius="8"
                            Command="{Binding SaveCommand}"
                            Content="保存"
                            FontWeight="SemiBold"
                            Foreground="White" />
                        <Button
                            Padding="24,8"
                            Background="#9CA3AF"
                            CornerRadius="8"
                            Command="{Binding CancelCommand}"
                            Content="取消"
                            FontWeight="SemiBold"
                            Foreground="White" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
