<UserControl
x:Class="MyFirstApp.Views.ForumView"
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:vm="using:MyFirstApp.ViewModels"
x:DataType="vm:ForumViewModel"
d:DesignHeight="600"
d:DesignWidth="900"
mc:Ignorable="d">
    <Border Background="#F9FAFB" CornerRadius="16" Margin="16" Padding="24">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
            <TextBlock Margin="0,0,0,16" FontSize="28" FontWeight="Bold" Foreground="#111827" Text="患者论坛" />
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,0,0,16">
                <TextBox Width="240" Text="{Binding SearchText}" Watermark="搜索标题/作者/分类..." CornerRadius="8" />
                <Button Padding="16,8" Background="#10B981" CornerRadius="8" Command="{Binding AddCommand}" Content="发布帖子" Foreground="White" />
                <Button Padding="16,8" Background="#3B82F6" CornerRadius="8" Command="{Binding EditCommand}" Content="编辑" Foreground="White" />
                <Button Padding="16,8" Background="#EF4444" CornerRadius="8" Command="{Binding DeleteCommand}" Content="删除" Foreground="White" />
            </StackPanel>
            <DataGrid Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding FilteredItems}" SelectedItem="{Binding SelectedItem}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="*" />
                    <DataGridTextColumn Header="作者" Binding="{Binding Author}" Width="100" />
                    <DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="100" />
                    <DataGridTextColumn Header="收藏数" Binding="{Binding FavoriteCount}" Width="80" />
                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="90" />
                    <DataGridTextColumn Header="发布时间" Binding="{Binding CreatedAt, StringFormat=\{0:MM-dd HH:mm\}}" Width="120" />
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Row="3" Margin="0,16,0,0" Padding="20" Classes="glass" IsVisible="{Binding IsEditing}">
                <StackPanel Spacing="12">
                    <TextBlock FontSize="18" FontWeight="Bold" Foreground="#111827" Text="编辑帖子" />
                    <StackPanel Spacing="6"><TextBlock Text="标题" /><TextBox Text="{Binding EditTitle}" /></StackPanel>
                    <StackPanel Spacing="6"><TextBlock Text="内容" /><TextBox Text="{Binding EditContent}" AcceptsReturn="True" Height="90" TextWrapping="Wrap" /></StackPanel>
                    <WrapPanel ItemWidth="180" ItemHeight="72">
                        <StackPanel Margin="0,0,16,0" Spacing="6"><TextBlock Text="作者" /><TextBox Text="{Binding EditAuthor}" /></StackPanel>
                        <StackPanel Margin="0,0,16,0" Spacing="6"><TextBlock Text="分类" /><TextBox Text="{Binding EditCategory}" /></StackPanel>
                        <StackPanel Margin="0,0,16,0" Spacing="6"><TextBlock Text="状态" /><ComboBox SelectedItem="{Binding EditStatus}" SelectedIndex="0"><x:String>已发布</x:String><x:String>待审核</x:String><x:String>已下架</x:String></ComboBox></StackPanel>
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Padding="24,8" Background="#10B981" CornerRadius="8" Command="{Binding SaveCommand}" Content="保存" Foreground="White" />
                        <Button Padding="24,8" Background="#9CA3AF" CornerRadius="8" Command="{Binding CancelCommand}" Content="取消" Foreground="White" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
