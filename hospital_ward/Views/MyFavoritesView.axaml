<UserControl
x:Class="MyFirstApp.Views.MyFavoritesView"
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:vm="using:MyFirstApp.ViewModels"
x:DataType="vm:MyFavoritesViewModel"
d:DesignHeight="600"
d:DesignWidth="900"
mc:Ignorable="d">
    <Border Background="#F9FAFB" CornerRadius="16" Margin="16" Padding="24">
        <StackPanel Spacing="16">
            <TextBlock FontSize="28" FontWeight="Bold" Foreground="#111827" Text="我的收藏" />
            <DataGrid AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding Items}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="帖子标题" Binding="{Binding PostTitle}" Width="*" />
                    <DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="120" />
                    <DataGridTextColumn Header="收藏时间" Binding="{Binding FavoritedAt, StringFormat=\{0:MM-dd HH:mm\}}" Width="140" />
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Border>
</UserControl>
