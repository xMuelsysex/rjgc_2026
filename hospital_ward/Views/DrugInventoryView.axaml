<UserControl
x:Class="MyFirstApp.Views.DrugInventoryView"
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:vm="using:MyFirstApp.ViewModels"
x:DataType="vm:DrugInventoryViewModel"
d:DesignHeight="600"
d:DesignWidth="900"
mc:Ignorable="d">

    <Border Background="#F9FAFB" CornerRadius="16" Margin="16" Padding="24">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
            <TextBlock Margin="0,0,0,16" FontSize="28" FontWeight="Bold" Foreground="#111827" Text="药品入库" />
            <StackPanel Grid.Row="1" Margin="0,0,0,16" Orientation="Horizontal" Spacing="10">
                <TextBox Width="260" Text="{Binding SearchText}" Watermark="搜索药品/批次/供应商..." CornerRadius="8" />
                <Button Padding="16,8" Background="#10B981" CornerRadius="8" Command="{Binding AddCommand}" Content="新增入库" Foreground="White" />
                <Button Padding="16,8" Background="#3B82F6" CornerRadius="8" Command="{Binding EditCommand}" Content="编辑" Foreground="White" />
                <Button Padding="16,8" Background="#EF4444" CornerRadius="8" Command="{Binding DeleteCommand}" Content="删除" Foreground="White" />
            </StackPanel>
            <DataGrid Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding FilteredItems}" SelectedItem="{Binding SelectedItem}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="药品名称" Binding="{Binding DrugName}" Width="*" />
                    <DataGridTextColumn Header="批次号" Binding="{Binding BatchNumber}" Width="120" />
                    <DataGridTextColumn Header="入库数量" Binding="{Binding Quantity}" Width="100" />
                    <DataGridTextColumn Header="单价" Binding="{Binding UnitCost, StringFormat=\{0:N2\}}" Width="100" />
                    <DataGridTextColumn Header="供应商" Binding="{Binding Supplier}" Width="120" />
                    <DataGridTextColumn Header="入库日期" Binding="{Binding ReceivedDate, StringFormat=\{0:yyyy-MM-dd\}}" Width="120" />
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Row="3" Margin="0,16,0,0" Padding="20" Classes="glass" IsVisible="{Binding IsEditing}">
                <StackPanel Spacing="14">
                    <TextBlock FontSize="18" FontWeight="Bold" Foreground="#111827" Text="编辑药品入库" />
                    <WrapPanel ItemWidth="180" ItemHeight="72">
                        <StackPanel Margin="0,0,16,0" Spacing="6"><TextBlock Text="药品名称" /><TextBox Text="{Binding EditDrugName}" /></StackPanel>
                        <StackPanel Margin="0,0,16,0" Spacing="6"><TextBlock Text="批次号" /><TextBox Text="{Binding EditBatchNumber}" /></StackPanel>
                        <StackPanel Margin="0,0,16,0" Spacing="6"><TextBlock Text="数量" /><NumericUpDown Value="{Binding EditQuantity}" Minimum="0" FormatString="N0" /></StackPanel>
                        <StackPanel Margin="0,0,16,0" Spacing="6"><TextBlock Text="单价" /><NumericUpDown Value="{Binding EditUnitCost}" Minimum="0" FormatString="N2" /></StackPanel>
                        <StackPanel Margin="0,0,16,0" Spacing="6"><TextBlock Text="供应商" /><TextBox Text="{Binding EditSupplier}" /></StackPanel>
                    </WrapPanel>
                    <StackPanel Spacing="6"><TextBlock Text="备注" /><TextBox Text="{Binding EditRemark}" AcceptsReturn="True" Height="60" TextWrapping="Wrap" /></StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Padding="24,8" Background="#10B981" CornerRadius="8" Command="{Binding SaveCommand}" Content="保存" Foreground="White" />
                        <Button Padding="24,8" Background="#9CA3AF" CornerRadius="8" Command="{Binding CancelCommand}" Content="取消" Foreground="White" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
