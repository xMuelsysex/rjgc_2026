<UserControl
x:Class="MyFirstApp.Views.NurseManagementView"
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:sys="clr-namespace:System;assembly=mscorlib"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:vm="using:MyFirstApp.ViewModels"
d:DesignHeight="600"
d:DesignWidth="900"
x:DataType="vm:NurseManagementViewModel"
mc:Ignorable="d">

    <Border Background="#F9FAFB" CornerRadius="16" Margin="16" Padding="24">
        <Grid RowDefinitions="Auto, Auto, *, Auto">
            <TextBlock
            Margin="0,0,0,16"
            FontSize="28"
            FontWeight="Bold"
            Foreground="#111827"
            Text="护士管理" />

            <StackPanel
            Grid.Row="1"
            Margin="0,0,0,16"
            Orientation="Horizontal"
            Spacing="10">
                <TextBox
                Width="240"
                Text="{Binding SearchText}"
                Watermark="搜索护士姓名/科室..."
                CornerRadius="8" />
                <Button
                Padding="16,8"
                Background="#10B981"
                CornerRadius="8"
                Command="{Binding AddCommand}"
                Content="添加护士"
                FontWeight="SemiBold"
                Foreground="White" />
                <Button
                Padding="16,8"
                Background="#3B82F6"
                CornerRadius="8"
                Command="{Binding EditCommand}"
                Content="编辑"
                FontWeight="SemiBold"
                Foreground="White" />
                <Button
                Padding="16,8"
                Background="#EF4444"
                CornerRadius="8"
                Command="{Binding DeleteCommand}"
                Content="删除"
                FontWeight="SemiBold"
                Foreground="White" />
            </StackPanel>

            <DataGrid
            Grid.Row="2"
            AutoGenerateColumns="False"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CanUserResizeColumns="True"
            CornerRadius="8"
            GridLinesVisibility="Horizontal"
            IsReadOnly="True"
            ItemsSource="{Binding FilteredItems}"
            SelectedItem="{Binding SelectedItem}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                    Width="100"
                    Binding="{Binding Name}"
                    Header="姓名" />
                    <DataGridTextColumn
                    Width="60"
                    Binding="{Binding Gender}"
                    Header="性别" />
                    <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Department}"
                    Header="科室" />
                    <DataGridTextColumn
                    Width="130"
                    Binding="{Binding Phone}"
                    Header="联系电话" />
                </DataGrid.Columns>
            </DataGrid>

            <Border
            Grid.Row="3"
            Classes="glass"
            Margin="0,16,0,0"
            Padding="20"
            IsVisible="{Binding IsEditing}">
                <StackPanel Spacing="16">
                    <TextBlock
                    FontSize="18"
                    FontWeight="Bold"
                    Foreground="#111827"
                    Text="编辑护士信息" />

                    <StackPanel Orientation="Horizontal" Spacing="20">
                        <StackPanel Spacing="6">
                            <TextBlock
                            FontSize="13"
                            Foreground="#6B7280"
                            FontWeight="Medium"
                            Text="姓名" />
                            <TextBox Width="120" CornerRadius="6" Text="{Binding EditName}" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock
                            FontSize="13"
                            Foreground="#6B7280"
                            FontWeight="Medium"
                            Text="性别" />
                            <ComboBox Width="80" CornerRadius="6" SelectedItem="{Binding EditGender}">
                                <x:String>男</x:String>
                                <x:String>女</x:String>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock
                            FontSize="13"
                            Foreground="#6B7280"
                            FontWeight="Medium"
                            Text="科室" />
                            <TextBox Width="120" CornerRadius="6" Text="{Binding EditDepartment}" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock
                            FontSize="13"
                            Foreground="#6B7280"
                            FontWeight="Medium"
                            Text="联系电话" />
                            <TextBox Width="140" CornerRadius="6" Text="{Binding EditPhone}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Spacing="12">
                        <Button
                        Padding="24,8"
                        Background="#10B981"
                        CornerRadius="8"
                        Command="{Binding SaveCommand}"
                        Content="保存"
                        FontWeight="SemiBold"
                        Foreground="White" />
                        <Button
                        Padding="24,8"
                        Background="#9CA3AF"
                        CornerRadius="8"
                        Command="{Binding CancelCommand}"
                        Content="取消"
                        FontWeight="SemiBold"
                        Foreground="White" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
