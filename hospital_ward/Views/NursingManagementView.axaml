<UserControl
x:Class="MyFirstApp.Views.NursingManagementView"
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:vm="using:MyFirstApp.ViewModels"
x:DataType="vm:NursingManagementViewModel"
d:DesignHeight="600"
d:DesignWidth="900"
mc:Ignorable="d">

    <Border Background="#F9FAFB" CornerRadius="16" Margin="16" Padding="24">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
            <TextBlock Margin="0,0,0,16" FontSize="28" FontWeight="Bold" Foreground="#111827" Text="护理管理" />
            <StackPanel Grid.Row="1" Margin="0,0,0,16" Orientation="Horizontal" Spacing="10">
                <TextBox Width="260" Text="{Binding SearchText}" Watermark="搜索患者/护士/状态..." CornerRadius="8" />
                <Button Padding="16,8" Background="#10B981" CornerRadius="8" Command="{Binding AddCommand}" Content="新增护理" Foreground="White" />
                <Button Padding="16,8" Background="#3B82F6" CornerRadius="8" Command="{Binding EditCommand}" Content="编辑" Foreground="White" />
                <Button Padding="16,8" Background="#EF4444" CornerRadius="8" Command="{Binding DeleteCommand}" Content="删除" Foreground="White" />
            </StackPanel>
            <DataGrid Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding FilteredItems}" SelectedItem="{Binding SelectedItem}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="患者姓名" Binding="{Binding PatientName}" Width="100" />
                    <DataGridTextColumn Header="护士" Binding="{Binding NurseName}" Width="100" />
                    <DataGridTextColumn Header="护理等级" Binding="{Binding CareLevel}" Width="100" />
                    <DataGridTextColumn Header="任务" Binding="{Binding TaskName}" Width="*" />
                    <DataGridTextColumn Header="计划时间" Binding="{Binding ScheduledTime, StringFormat=\{0:yyyy-MM-dd HH:mm\}}" Width="150" />
                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Row="3" Margin="0,16,0,0" Padding="20" Classes="glass" IsVisible="{Binding IsEditing}">
                <StackPanel Spacing="14">
                    <TextBlock FontSize="18" FontWeight="Bold" Foreground="#111827" Text="编辑护理任务" />
                    <WrapPanel ItemWidth="180" ItemHeight="72">
                        <StackPanel Margin="0,0,16,0" Spacing="6"><TextBlock Text="患者姓名" /><TextBox Text="{Binding EditPatientName}" /></StackPanel>
                        <StackPanel Margin="0,0,16,0" Spacing="6"><TextBlock Text="护士姓名" /><TextBox Text="{Binding EditNurseName}" /></StackPanel>
                        <StackPanel Margin="0,0,16,0" Spacing="6"><TextBlock Text="护理等级" /><ComboBox SelectedItem="{Binding EditCareLevel}" SelectedIndex="0"><x:String>一级护理</x:String><x:String>二级护理</x:String><x:String>三级护理</x:String></ComboBox></StackPanel>
                        <StackPanel Margin="0,0,16,0" Spacing="6"><TextBlock Text="状态" /><ComboBox SelectedItem="{Binding EditStatus}" SelectedIndex="0"><x:String>待执行</x:String><x:String>执行中</x:String><x:String>已完成</x:String></ComboBox></StackPanel>
                    </WrapPanel>
                    <StackPanel Spacing="6"><TextBlock Text="护理任务" /><TextBox Text="{Binding EditTaskName}" /></StackPanel>
                    <StackPanel Spacing="6"><TextBlock Text="备注" /><TextBox Text="{Binding EditRemark}" AcceptsReturn="True" Height="60" TextWrapping="Wrap" /></StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Padding="24,8" Background="#10B981" CornerRadius="8" Command="{Binding SaveCommand}" Content="保存" Foreground="White" />
                        <Button Padding="24,8" Background="#9CA3AF" CornerRadius="8" Command="{Binding CancelCommand}" Content="取消" Foreground="White" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
