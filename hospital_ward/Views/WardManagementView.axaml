<UserControl
    x:Class="MyFirstApp.Views.WardManagementView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:MyFirstApp.ViewModels"
    d:DesignHeight="600"
    d:DesignWidth="900"
    x:DataType="vm:WardManagementViewModel"
    mc:Ignorable="d">

    <Border Background="#F9FAFB" CornerRadius="16" Margin="16" Padding="24">
        <Grid RowDefinitions="Auto, Auto, *, Auto">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="28"
                FontWeight="Bold"
                Foreground="#111827"
                Text="病房管理" />
                
            <StackPanel
                Grid.Row="1"
                Margin="0,0,0,16"
                Orientation="Horizontal"
                Spacing="10">
                <TextBox
                    Width="240"
                    Text="{Binding SearchText}"
                    Watermark="搜索病房号/科室/类型..."
                    CornerRadius="8" />
                <Button
                    Padding="16,8"
                    Background="#10B981"
                    CornerRadius="8"
                    Command="{Binding AddCommand}"
                    Content="添加病房"
                    FontWeight="SemiBold"
                    Foreground="White" />
                <Button
                    Padding="16,8"
                    Background="#3B82F6"
                    CornerRadius="8"
                    Command="{Binding EditCommand}"
                    Content="编辑"
                    FontWeight="SemiBold"
                    Foreground="White" />
                <Button
                    Padding="16,8"
                    Background="#EF4444"
                    CornerRadius="8"
                    Command="{Binding DeleteCommand}"
                    Content="删除"
                    FontWeight="SemiBold"
                    Foreground="White" />
            </StackPanel>
            
            <DataGrid
                Grid.Row="2"
                AutoGenerateColumns="False"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CanUserResizeColumns="True"
                CornerRadius="8"
                GridLinesVisibility="Horizontal"
                IsReadOnly="True"
                ItemsSource="{Binding FilteredItems}"
                SelectedItem="{Binding SelectedItem}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding WardNumber}"
                        Header="病房号" />
                    <DataGridTextColumn
                        Width="80"
                        Binding="{Binding Type}"
                        Header="类型" />
                    <DataGridTextColumn
                        Width="80"
                        Binding="{Binding BedCount}"
                        Header="床位数" />
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Department}"
                        Header="所属科室" />
                </DataGrid.Columns>
            </DataGrid>
            
            <Border
                Grid.Row="3"
                Classes="glass"
                Margin="0,16,0,0"
                Padding="20"
                IsVisible="{Binding IsEditing}">
                <StackPanel Spacing="16">
                    <TextBlock
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="#111827"
                        Text="编辑病房信息" />
                        
                    <StackPanel Orientation="Horizontal" Spacing="20">
                        <StackPanel Spacing="6">
                            <TextBlock
                                FontSize="13"
                                Foreground="#6B7280"
                                FontWeight="Medium"
                                Text="病房号" />
                            <TextBox Width="160" CornerRadius="6" Text="{Binding EditWardNumber}" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock
                                FontSize="13"
                                Foreground="#6B7280"
                                FontWeight="Medium"
                                Text="类型" />
                            <ComboBox Width="120" CornerRadius="6" SelectedItem="{Binding EditType}">
                                <ComboBoxItem Content="普通" />
                                <ComboBoxItem Content="VIP" />
                                <ComboBoxItem Content="ICU" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock
                                FontSize="13"
                                Foreground="#6B7280"
                                FontWeight="Medium"
                                Text="床位数" />
                            <NumericUpDown
                                Width="120"
                                CornerRadius="6"
                                Maximum="20"
                                Minimum="0"
                                Value="{Binding EditBedCount}" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock
                                FontSize="13"
                                Foreground="#6B7280"
                                FontWeight="Medium"
                                Text="所属科室" />
                            <TextBox Width="160" CornerRadius="6" Text="{Binding EditDepartment}" />
                        </StackPanel>
                    </StackPanel>
                    
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Spacing="12">
                        <Button
                            Padding="24,8"
                            Background="#10B981"
                            CornerRadius="8"
                            Command="{Binding SaveCommand}"
                            Content="保存"
                            FontWeight="SemiBold"
                            Foreground="White" />
                        <Button
                            Padding="24,8"
                            Background="#9CA3AF"
                            CornerRadius="8"
                            Command="{Binding CancelCommand}"
                            Content="取消"
                            FontWeight="SemiBold"
                            Foreground="White" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
