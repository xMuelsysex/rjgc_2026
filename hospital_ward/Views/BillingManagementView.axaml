<UserControl
x:Class="MyFirstApp.Views.BillingManagementView"
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:vm="using:MyFirstApp.ViewModels"
x:DataType="vm:BillingManagementViewModel"
d:DesignHeight="600"
d:DesignWidth="900"
mc:Ignorable="d">

    <Border Background="#F9FAFB" CornerRadius="16" Margin="16" Padding="24">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
            <TextBlock Margin="0,0,0,16" FontSize="28" FontWeight="Bold" Foreground="#111827" Text="费用管理" />
            <StackPanel Grid.Row="1" Margin="0,0,0,16" Orientation="Horizontal" Spacing="10">
                <TextBox Width="260" Text="{Binding SearchText}" Watermark="搜索患者/科室/状态..." CornerRadius="8" />
                <Button Padding="16,8" Background="#10B981" CornerRadius="8" Command="{Binding AddCommand}" Content="新增账单" Foreground="White" />
                <Button Padding="16,8" Background="#3B82F6" CornerRadius="8" Command="{Binding EditCommand}" Content="编辑" Foreground="White" />
                <Button Padding="16,8" Background="#EF4444" CornerRadius="8" Command="{Binding DeleteCommand}" Content="删除" Foreground="White" />
            </StackPanel>
            <DataGrid Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding FilteredItems}" SelectedItem="{Binding SelectedItem}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="患者姓名" Binding="{Binding PatientName}" Width="100" />
                    <DataGridTextColumn Header="科室" Binding="{Binding Department}" Width="100" />
                    <DataGridTextColumn Header="总费用" Binding="{Binding TotalAmount, StringFormat=\{0:N2\}}" Width="100" />
                    <DataGridTextColumn Header="已支付" Binding="{Binding PaidAmount, StringFormat=\{0:N2\}}" Width="100" />
                    <DataGridTextColumn Header="医保" Binding="{Binding InsuranceAmount, StringFormat=\{0:N2\}}" Width="100" />
                    <DataGridTextColumn Header="待结算" Binding="{Binding OutstandingAmount, StringFormat=\{0:N2\}}" Width="100" />
                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Row="3" Margin="0,16,0,0" Padding="20" Classes="glass" IsVisible="{Binding IsEditing}">
                <StackPanel Spacing="14">
                    <TextBlock FontSize="18" FontWeight="Bold" Foreground="#111827" Text="编辑费用账单" />
                    <WrapPanel ItemWidth="180" ItemHeight="72">
                        <StackPanel Margin="0,0,16,0" Spacing="6"><TextBlock Text="患者姓名" /><TextBox Text="{Binding EditPatientName}" /></StackPanel>
                        <StackPanel Margin="0,0,16,0" Spacing="6"><TextBlock Text="科室" /><TextBox Text="{Binding EditDepartment}" /></StackPanel>
                        <StackPanel Margin="0,0,16,0" Spacing="6"><TextBlock Text="总费用" /><NumericUpDown Value="{Binding EditTotalAmount}" Minimum="0" FormatString="N2" /></StackPanel>
                        <StackPanel Margin="0,0,16,0" Spacing="6"><TextBlock Text="已支付" /><NumericUpDown Value="{Binding EditPaidAmount}" Minimum="0" FormatString="N2" /></StackPanel>
                        <StackPanel Margin="0,0,16,0" Spacing="6"><TextBlock Text="医保金额" /><NumericUpDown Value="{Binding EditInsuranceAmount}" Minimum="0" FormatString="N2" /></StackPanel>
                        <StackPanel Margin="0,0,16,0" Spacing="6"><TextBlock Text="状态" /><ComboBox SelectedItem="{Binding EditStatus}" SelectedIndex="0"><x:String>待结算</x:String><x:String>已结算</x:String></ComboBox></StackPanel>
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Padding="24,8" Background="#10B981" CornerRadius="8" Command="{Binding SaveCommand}" Content="保存" Foreground="White" />
                        <Button Padding="24,8" Background="#9CA3AF" CornerRadius="8" Command="{Binding CancelCommand}" Content="取消" Foreground="White" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
