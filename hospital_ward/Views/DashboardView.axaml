<UserControl
x:Class="MyFirstApp.Views.DashboardView"
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:vm="using:MyFirstApp.ViewModels"
d:DesignHeight="600"
d:DesignWidth="900"
x:DataType="vm:DashboardViewModel"
mc:Ignorable="d">

    <UserControl.Styles>
        <!-- 优化: Avalonia Style.Animations 仅支持 Opacity/double 属性动画，stagger 交错淡入 -->
        <Style Selector="Border.stat-card.delay-0">
            <Style.Animations>
                <Animation Duration="0:0:0.35" Delay="0:0:0.00" Easing="CubicEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border.stat-card.delay-1">
            <Style.Animations>
                <Animation Duration="0:0:0.35" Delay="0:0:0.05" Easing="CubicEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border.stat-card.delay-2">
            <Style.Animations>
                <Animation Duration="0:0:0.35" Delay="0:0:0.10" Easing="CubicEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border.stat-card.delay-3">
            <Style.Animations>
                <Animation Duration="0:0:0.35" Delay="0:0:0.15" Easing="CubicEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border.stat-card.delay-4">
            <Style.Animations>
                <Animation Duration="0:0:0.35" Delay="0:0:0.20" Easing="CubicEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border.stat-card.delay-5">
            <Style.Animations>
                <Animation Duration="0:0:0.35" Delay="0:0:0.25" Easing="CubicEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border.stat-card.delay-6">
            <Style.Animations>
                <Animation Duration="0:0:0.35" Delay="0:0:0.30" Easing="CubicEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border.stat-card.delay-7">
            <Style.Animations>
                <Animation Duration="0:0:0.35" Delay="0:0:0.35" Easing="CubicEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border.stat-card.delay-8">
            <Style.Animations>
                <Animation Duration="0:0:0.35" Delay="0:0:0.40" Easing="CubicEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <Border Background="#F9FAFB" CornerRadius="16" Margin="16" Padding="24">
        <Grid RowDefinitions="Auto, Auto, *">
            <TextBlock
            Margin="0,0,0,24"
            FontSize="28"
            FontWeight="Bold"
            Foreground="#111827"
            Text="系统首页" />

            <!--  统计卡片 第一行，每张卡片添加 stagger delay class  -->
            <UniformGrid Grid.Row="1" VerticalAlignment="Top" Columns="5" Rows="1">
                <Border Classes="glass stat-card delay-0" Margin="8" Padding="20">
                    <StackPanel>
                        <TextBlock Classes="glass-title" Text="总床位数" />
                        <TextBlock Classes="glass-value" Foreground="#3B82F6" Text="{Binding TotalBeds}" />
                    </StackPanel>
                </Border>
                <Border Classes="glass stat-card delay-1" Margin="8" Padding="20">
                    <StackPanel>
                        <TextBlock Classes="glass-title" Text="空闲床位" />
                        <TextBlock Classes="glass-value" Foreground="#10B981" Text="{Binding AvailableBeds}" />
                    </StackPanel>
                </Border>
                <Border Classes="glass stat-card delay-2" Margin="8" Padding="20">
                    <StackPanel>
                        <TextBlock Classes="glass-title" Text="占用床位" />
                        <TextBlock Classes="glass-value" Foreground="#F59E0B" Text="{Binding OccupiedBeds}" />
                    </StackPanel>
                </Border>
                <Border Classes="glass stat-card delay-3" Margin="8" Padding="20">
                    <StackPanel>
                        <TextBlock Classes="glass-title" Text="今日入院" />
                        <TextBlock Classes="glass-value" Foreground="#EF4444" Text="{Binding TodayAdmissions}" />
                    </StackPanel>
                </Border>
                <Border Classes="glass stat-card delay-4" Margin="8" Padding="20">
                    <StackPanel>
                        <TextBlock Classes="glass-title" Text="今日出院" />
                        <TextBlock Classes="glass-value" Foreground="#8B5CF6" Text="{Binding TodayDischarges}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!--  统计卡片 第二行  -->
            <UniformGrid Grid.Row="2" Margin="0,16,0,0" VerticalAlignment="Top" Columns="4" Rows="1">
                <Border Classes="glass stat-card delay-5" Margin="8" Padding="20">
                    <StackPanel>
                        <TextBlock Classes="glass-title" Text="维修床位" />
                        <TextBlock Classes="glass-value" Foreground="#059669" Text="{Binding MaintenanceBeds}" />
                    </StackPanel>
                </Border>
                <Border Classes="glass stat-card delay-6" Margin="8" Padding="20">
                    <StackPanel>
                        <TextBlock Classes="glass-title" Text="在院患者" />
                        <TextBlock Classes="glass-value" Foreground="#0284C7" Text="{Binding InPatientCount}" />
                    </StackPanel>
                </Border>
                <Border Classes="glass stat-card delay-7" Margin="8" Padding="20">
                    <StackPanel>
                        <TextBlock Classes="glass-title" Text="医生数量" />
                        <TextBlock Classes="glass-value" Foreground="#0D9488" Text="{Binding DoctorCount}" />
                    </StackPanel>
                </Border>
                <Border Classes="glass stat-card delay-8" Margin="8" Padding="20">
                    <StackPanel>
                        <TextBlock Classes="glass-title" Text="床位占用率" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Classes="glass-value" Foreground="#D97706" Text="{Binding OccupancyRate}" />
                            <TextBlock Margin="4,0,0,6" VerticalAlignment="Bottom"
                                       FontSize="18" FontWeight="Bold" Foreground="#D97706" Text="%" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </Grid>
    </Border>
</UserControl>
